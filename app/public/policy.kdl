// Compatibility policy (issues #135, #136, #137, #138). Rules let an
// operator override the default transit decision for narrowly scoped
// compatibility cases. Grammar: docs/policy.md.
//
//   rule "short-id" priority=10 {
//     match host="cdn.example.com" path="/assets/"  // both optional
//     types "script" "fetch"                        // optional
//     route "rewrite"                               // or "native", "relay" or "wisp"
//     reason "short operator explanation"           // optional
//   }
//
// route "rewrite" upgrades matching requests onto the rewrite path.
// route "native" (#138) demotes the JS literal pass for hosts whose
// raw script bodies work through the patched runtime seams.
// route "relay" (#137) moves the fetch onto the embedder's network
// stack for hosts that block the wasm TLS ClientHello shapes.
// route "wisp" (#168) rides the engine's own wasm wisp transport
// through the PUBLIC wisp endpoint the embedder announces.
// Highest priority wins; on equal priority the later rule wins. A
// rejected file keeps the defaults active (diagnostics carry the
// error).

// 2026-11-22 epoxy switch (#708/#642 follow-up): the LB deployments
// ride a public wisp transit by default now (anura, announced as
// /build sjWisp from the SCRAMJET_WISP_URL env; the engine transport
// is epoxy), because the Google risk gate refuses the datacenter
// egress the embedder relay exits from. The wave-17 default-relay
// catch-all is deleted: its reason (the deployment wisp being
// password-authed, the wasm client refused) is gone for deployments
// that announce a public endpoint, so the engine's default path - the
// embedder-selected primary wisp client - carries everything again.
// The per-host relay rules below survive unchanged (their hosts reject
// the wasm TLS/h2 shapes), and the stall-storm cooldown still rides
// the relay when an embedder channel is registered. A deployment that
// keeps an auth-wisp and announces no endpoint restores the legacy
// remedy: a match-less "relay" rule first in this file
// (docs/integration-guide.md) or the armed zl:wispAuth lane.

// #154: Google's gapi loader sanity-validates every generated module
// URL against an origin-pinning regex (^https?://<host>.google(rs)?.com).
// The JS literal pass rewrites the "https://apis.google.com" literal into
// an opaque route token, the regex rejects the token host and the loader
// throws before any fetch ("Bad hint: failed sanity"). route "native"
// serves the script body raw; the module loads then run as ordinary
// cross-origin requests from a controlled page, which the engine fetches
// itself (#34), so nothing goes direct. The transport composes: the
// engine's default path carries the wire.
rule "gapi-native" priority=10 {
  match host="apis.google.com"
  types "script"
  route "native"
  reason "#154: gapi origin-pinning sanity rejects route-token literals"
}

// #168: brave search's bot wall is the inverse of the #149 set: it
// refuses the embedder relay transport class (the PoW interstitial
// never completes) and accepts the engine's own wasm wisp ClientHello
// through the PUBLIC wisp endpoint the embedder announces (the
// ScramJet wisp-js backend, zl:wispRegister; LB serves it as
// /build sjWisp). The route carries only when the embedder announced
// that endpoint; without it the fetch rides the default path and a
// TRANSPORT warning names the gap. Honest ceiling: the public
// endpoint's egress is shared with the ScramJet engine option.
rule "brave-wisp" {
  match host="search.brave.com"
  route "wisp"
  reason "#168: relay transport class refused, wasm wisp ClientHello accepted"
}

// #137: duckduckgo.com rejects the wasm TLS client shapes at the
// handshake (libcurl error 35, epoxy UnexpectedEof) while native
// stacks from the same IP pass; the embedder relays with its own TLS.
rule "ddg-relay" {
  match host="duckduckgo.com"
  route "relay"
  reason "TLS-fingerprint block: wasm ClientHello rejected, embedder relay"
}

// #149 (closed not_planned): the hosts below reject the wasm TLS/h2
// client shapes deterministically while direct fetches from the same
// egress pass: cbc/united/opentable/acer fail in the HTTP/2 framing
// layer (libcurl error 92, epoxy RST_STREAM(1) INTERNAL_ERROR),
// slither.io fails at the TLS handshake (libcurl error 35, epoxy
// handshake eof). The wisp relay itself is byte-honest (a native TLS
// client carried through the exact same tunnel gets identical
// responses, suite/e2e/wisp-tls-probe.mjs), so the block is upstream
// bot management fingerprinting the wasm stacks. The embedder relays
// these hosts with its own TLS.
rule "cbc-relay" {
  match host="cbc.ca"
  route "relay"
  reason "#149: h2 framing reject of wasm client shapes, embedder relay"
}
rule "united-relay" {
  match host="united.com"
  route "relay"
  reason "#149: h2 framing reject of wasm client shapes, embedder relay"
}
rule "opentable-relay" {
  match host="opentable.com"
  route "relay"
  reason "#149: h2 framing reject of wasm client shapes, embedder relay"
}
rule "acer-relay" {
  match host="acer.com"
  route "relay"
  reason "#149: h2 framing reject of wasm client shapes, embedder relay"
}
rule "slither-relay" {
  match host="slither.io"
  route "relay"
  reason "#149: TLS handshake reject of wasm ClientHello, embedder relay"
}

// delta.com: TLS connect refused from the test egress (egress-level,
// not proven upstream), relay gives it a native stack + the
// deployer's egress.
rule "delta-relay" {
  match host="delta.com"
  route "relay"
  reason "#149: TLS connect refused at test egress, embedder relay"
}

// #642: Google risk-rejects the sign-in flow from datacenter egress
// (triple-proven on #633; no engine defect remains on the sign-in path).
// #642: the sign-in hosts need no per-host rule after the 2026-11-22
// epoxy switch: they ride the engine default path (the primary wisp
// client the embedder selects) like every other unrouted host, so the
// trusted-egress lane is now the deployment's announced endpoint
// itself. Trusted-egress deployments that need a private passworded
// wisp own credentials keep the zl:wispAuth lane instead
// (docs/wisp-auth-client.md).

