// Default interception rules (Phase 1). The ad + tracker host lists
// are migrated from the browser app's server-side engine so
// client-side mode blocks the same hosts. allow = captcha/anti-bot
// widget hosts that must never be stripped (same policy as the
// server engine). Grammar: docs/interception.md.

block "doubleclick.net"
block "googlesyndication.com"
block "googleadservices.com"
block "adservice.google.com"
block "adnxs.com"
block "adsrvr.org"
block "criteo.com"
block "taboola.com"
block "outbrain.com"
block "rubiconproject.com"
block "pubmatic.com"
block "openx.net"
block "smartadserver.com"
block "teads.tv"
block "google-analytics.com"
block "googletagmanager.com"
block "analytics.google.com"
block "scorecardresearch.com"
block "quantserve.com"
block "hotjar.com"
block "mouseflow.com"
block "fullstory.com"
block "clarity.ms"
block "segment.io"
block "mixpanel.com"
block "amplitude.com"

allow "challenges.cloudflare.com"
allow "cloudflare.com"
allow "js.stripe.com"
allow "hcaptcha.com"
allow "www.google.com"
allow "recaptcha.net"
// Google sign-in risk telemetry: the identifier step's BotGuard
// scoring consumes the unified client log on play.google.com/log,
// and the default uBO/EasyList lists block it (5x BLOCKED_RULES in
// the 2026-11-26 capture). #720's controlled run (adblock off,
// log delivered 5x200) shows delivery alone does not clear the
// MI613e refusal, so this is sign-in flow hygiene under the same
// never-strip policy as the captcha hosts, not a sign-in fix.
// Fetch-typed: the /log beacons ride empty-destination requests.
allow "play.google.com" { types "fetch" }
// YouTube watch streams: generic uBO/EasyList video-ad filters
// otherwise catch the rr*.googlevideo.com videoplayback hosts, so
// the static allow entry (which beats the live matcher) is required
// for playback. Telemetry stays blocked by the live lists.
allow "googlevideo.com"
